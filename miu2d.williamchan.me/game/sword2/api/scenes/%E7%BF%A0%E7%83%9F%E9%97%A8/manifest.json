\n\tTalk(43140,43160);\n\tReturn;\n\t\n@Talk1:\n\tIf ($CuiYanMen2QiuYiShui == 1) @Talk3;\n\tTalk(43020,43110);\n\tAssign($CuiYanMen2QiuYiShui,1);\n\tAssign($CuiYanMen2AllFinish,1);\n\tAssign($CuiYanMen2Fighting,3);\n\tAddGoods(\"book-翠烟门秘笈.ini\");\n\tReturn;\n\n@Talk3:\n\tTalk(43120,43130);\n\tReturn;\n\t","后院仆妇.txt":"//翠烟门弟子\n\n\tTalk(43220,43220);\n\tReturn;\n","后院女佣.txt":"//翠烟门弟子\n\n\tTalk(43230,43230);\n\tReturn;\n","后院女童.txt":"//翠烟门弟子\n\n\tTalk(43200,43200);\n\tReturn;\n","后院男童.txt":"//翠烟门弟子\n\n\tTalk(43210,43210);\n\tReturn;\n","唐影对话.txt":"//完事后的唐影\n\n\tIf ($CuiYanMen2QiuYiShui==1) @Talk3;\n\tIf ($CuiYanMen2DiZi >= 5) @Talk2;\n\tTalk(43170,43190);\n\tReturn;\n@Talk2:\n\tTalk(43440,43440);\n\tReturn;\n\t\n@Talk3:\n\tTalk(43120,43130);\n\tReturn;\n","地图切换.txt":"//翠烟门-野外\n\t\n\tIf ($CuiYanMen2Fighting==1) @Talk1;\n\tIf ($CuiYanMen2Fighting==2) @Talk2;\n\tFadeOut();\n\tSaveNpc();\n\tSaveObj();\n\tLoadMap(\"别离村-翠烟门.map\");\n\tLoadNpc(\"Bie-Cui.npc\");\n\tLoadObj(\"Bie-Cui.obj\");\n\tSetPlayerPos(2,6);\n\tSetPlayerDir(7);\n\tFadeIn();\n\tIf ($CuiYanMen2AllFinish==1) @Talk3;\n\tShowMessage(\"野外\");\n\tReturn;\n\t\n@Talk1:\n\tDisableNpcAI();\n\tTalk(43000,43000);\n\tPlayerGoto(144,61);\n\tSetMapTrap(1,\"地图切换.txt\");\n\tEnableNpcAI();\n\tReturn;\n\t\n@Talk2:\n\tTalk(43010,43010);\n\tPlayerGoto(144,61);\n\tSetMapTrap(1,\"地图切换.txt\");\n\tReturn;\n\t\n@Talk3:\n\tAssign($CuiYanMen2AllFinish,2);\n\treturn;\n","后院女童1.txt":"//翠烟门弟子\n\n\tTalk(43240,43240);\n\tReturn;\n","带唐影进翠烟门.txt":"\tSetNpcKind(\"唐影\",0);\n\tNpcGotoEx(\"南宫飞云\",128,93);\n\tNpcGoto(\"唐影\",128,95);\n\tTalk(42830,42910);\n\tNpcGotoEx(\"秋依水\",123,108);\n\tSleep(500);\n\tNpcGoto(\"唐影\",123,107);\n\tDelNpc(\"秋依水\");\n\tDelNpc(\"唐影\");\n\tTalk(42920,42920);\n\tAssign($CuiYanMen2Finish,2);\n\tPlayerGoto(128,94);\n\tTalk(42930,42980);\n\tPlayMusic(\"KS77.wav\");\n\tFadeOut();\n\tLoadNpc(\"CuiYM2.npc\");\n\tLoadObj(\"CuiYM1.obj\");\n\tFadeIn();\n\tAssign($CuiYanMen2Fighting,1);\n\tSetMapTrap(2,\"\");\n\tSaveMapTrap();\n\tEnableFight();\n\tEnableJump();\n\tEnableRun();\n\tReturn;"},"traps":{"地图陷阱1.txt":"//翠烟门-野外\n\n\tIf ($CuiYanMen2Fighting==1) @Talk1;\n\tIf ($CuiYanMen2Fighting==2) @Talk2;\n\tFadeOut();\n\tSaveNpc();\n\tLoadMap(\"别离村-翠烟门.map\");\n\tLoadNpc(\"BieToCui.npc\");\n\tLoadObj(\"BieToCui.obj\");\n\tSetPlayerPos(5,153);\n\tSetPlayerDir(5);\n\tIf($CuiYanMen2CunLanMusic == 0) @Label1;\n\tPlayMusic(\"ks67.wav\");\n\t\n@Label1:\n\tFadeIn();\n\tIf ($CuiYanMen2AllFinish==1) @Talk3;\n\tShowMessage(\"野外\");\n\tReturn;\n\t\n@Talk1:\n\tDisableNpcAI();\n\tTalk(43000,43000);\n\tNpcGotoDir(\"南宫飞云\",1,1);\n\tSetMapTrap(1,\"地图陷阱1.txt\");\n\tEnableNpcAI();\n\tReturn;\n\t\n@Talk2:\n\tTalk(43010,43010);\n\tNpcGotoDir(\"南宫飞云\",1,1);\n\tSetMapTrap(1,\"地图陷阱1.txt\");\n\tReturn;\n\t\n@Talk3:\n\tAssign($CuiYanMen2AllFinish,2);\n\treturn;\n","地图陷阱2.txt":"// 翠烟门\n\n\tTalk(42380,42380);\n\tPlayerGotoDir(5,2);\n\tSetMapTrap(2,\"地图陷阱2.txt\");\n\tReturn;\n\t\n\t","地图陷阱3.txt":"// 翠烟门\n\n\tDisableNpcAI();\n\tTalk(42390,42390);\n\tPlayerGoto(112,128);\n\tSetMapTrap(3,\"地图陷阱3.txt\");\n\tEnableNpcAI();\n\tReturn;\n\t\n\t"}}